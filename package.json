{
  "name": "@buckitup/pq-client",
  "version": "1.2.0",
  "description": "BuckitUp post-quantum protocol client: identities, PRF vault, signed rows, transport, dialogs, User Storage, vouches and venues (origins)",
  "keywords": [
    "buckitup",
    "post-quantum",
    "ml-dsa",
    "ml-kem",
    "end-to-end-encryption",
    "electric-sql"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buckitup-chat/pq-library.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build",
    "check:consumer": "vite-node --root . scripts/consumer-check.ts",
    "lint": "eslint src",
    "schema:check": "node scripts/gen-pq-schema.mjs --check"
  },
  "dependencies": {
    "@lo-fi/local-data-lock": "^0.16.0",
    "@lo-fi/local-vault": "^0.18.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.5.4",
    "@noble/secp256k1": "^2.2.3",
    "qwbp": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "fake-indexeddb": "^6.2.5",
    "libsodium-wrappers": "0.7.15",
    "typescript": "~5.8.0",
    "vitest": "^3.2.0",
    "vite-node": "3.2.4",
    "playwright": "1.62.1",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "@typescript-eslint/parser": "8.64.0",
    "globals": "16.5.0"
  },
  "bugs": {
    "url": "https://github.com/Buckitup-chat/pq-library/issues"
  }
}
